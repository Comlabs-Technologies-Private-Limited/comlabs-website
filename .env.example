# ── Contact form ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@comlabstechnologies.com
CONTACT_FROM_EMAIL=ComLabs Website <onboarding@resend.dev>

# ── Site URL ──────────────────────────────────────────────────────────────────
# Production: https://comlabstechnologies.com (connect custom domain in Vercel, set as primary)
NEXT_PUBLIC_SITE_URL=https://comlabstechnologies.com

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET=

# Single-admin credentials
ADMIN_EMAIL=admin@comlabstechnologies.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@comlabstechnologies.com

# Generate a bcrypt hash of your password:
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# ── Vercel Blob (image uploads) ───────────────────────────────────────────────
# Add via: vercel env add BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# ── MCP server (claude.ai custom connector) ───────────────────────────────────
# Generate a random secret: openssl rand -base64 32
# Passed as the Authorization: Bearer <token> header when calling /api/mcp
MCP_API_KEY=
