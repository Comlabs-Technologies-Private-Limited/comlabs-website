# ── Contact form (SMTP / Nodemailer) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=directorcomlabs@gmail.com
SMTP_PASS=
SMTP_FROM=directorcomlabs@gmail.com
CONTACT_TO_EMAIL=admin@comlabstechnologies.com

# ── Site URL ──────────────────────────────────────────────────────────────────
# Production: https://www.comlabstechnologies.com
NEXT_PUBLIC_SITE_URL=https://www.comlabstechnologies.com

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Blog ──────────────────────────────────────────────────────────────────────
# Blog is public by default. Set to false to hide /blog and nav/footer links.
NEXT_PUBLIC_BLOG_ENABLED=true

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@comlabstechnologies.com
# Generate with: npm run admin:hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ── Legacy Auth.js (optional) ─────────────────────────────────────────────────
AUTH_SECRET=
NEXT_PUBLIC_ADMIN_EMAIL=admin@comlabstechnologies.com

# ── Cloudinary (site images + admin/MCP uploads) ──────────────────────────────
# Delivery (required — marketing images live on Cloudinary, not /public)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_ASSETS_FOLDER=comlabs-website
# Upload (required to push /public assets and admin media)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vercel Blob (fallback for MCP/admin uploads if Cloudinary is unset) ───────
BLOB_READ_WRITE_TOKEN=

# ── MCP server ────────────────────────────────────────────────────────────────
MCP_API_KEY=
