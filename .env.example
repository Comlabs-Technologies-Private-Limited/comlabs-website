# ── Contact form (SMTP / Nodemailer) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=directorcomlabs@gmail.com
SMTP_PASS=
SMTP_FROM=directorcomlabs@gmail.com
CONTACT_TO_EMAIL=admin@comlabstechnologies.com

# ── Site URL ──────────────────────────────────────────────────────────────────
# Production: https://www.comlabstechnologies.com
NEXT_PUBLIC_SITE_URL=https://www.comlabstechnologies.com

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Blog ──────────────────────────────────────────────────────────────────────
# Blog routes require MONGODB_URI. Set this to true when the blog is live publicly.
NEXT_PUBLIC_BLOG_ENABLED=false

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@comlabstechnologies.com
# Generate with: npm run admin:hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ── Legacy Auth.js (optional) ─────────────────────────────────────────────────
AUTH_SECRET=
NEXT_PUBLIC_ADMIN_EMAIL=admin@comlabstechnologies.com

# ── Vercel Blob (MCP image uploads + admin media) ─────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── MCP server ────────────────────────────────────────────────────────────────
MCP_API_KEY=
